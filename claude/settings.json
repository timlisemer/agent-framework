{
  "model": "opus[1m]",
  "alwaysThinkingEnabled": true,
  "voiceEnabled": true,
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true
  },
  "statusLine": {
    "type": "command",
    "command": "node $AGENT_FRAMEWORK_ROOT/dist/scripts/statusline.js"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node $AGENT_FRAMEWORK_ROOT/dist/hooks/pre-tool-use.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node $AGENT_FRAMEWORK_ROOT/dist/hooks/post-tool-use.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node $AGENT_FRAMEWORK_ROOT/dist/hooks/stop-response-check.js",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
